# FastMe RAG Framework - Environment Variables Configuration
# FastMe RAG 框架 - 环境变量配置
#
# 复制此文件为 .env 并修改配置值
# Copy this file to .env and modify configuration values

# =============================================================================
# 配置优先级说明 / Configuration Priority
# =============================================================================
# 分层配置优先级（从高到低）：
# Multi-layer configuration priority (high to low):
#
# 第 1 层：FastMeRAG(config={...}) 直接传入的配置字典
#        Layer 1: Configuration dictionary passed directly
#
# 第 2 层：环境变量覆盖层（FASTME_EMBEDDING_MODEL 等）
#        Layer 2: Environment variable override layer
#        → 环境变量会自动覆盖 YAML 配置文件中的对应值
#        → Environment variables automatically override YAML config values
#
# 第 3 层：FASTME_CONFIG 环境变量指向的 YAML 配置文件（基础配置）
#        Layer 3: YAML config file pointed by FASTME_CONFIG (base config)
#
# 第 4 层：代码中的默认配置 (DEFAULT_CONFIG)
#        Layer 4: Default configuration in code
#
# 示例 / Example:
# - YAML 配置：embedding.model_name = "BAAI/bge-m3"
# - 环境变量：FASTME_EMBEDDING_MODEL = "./models/bge-m3"
# - 最终结果：embedding.model_name = "./models/bge-m3" (环境变量覆盖)
#
# 推荐用法 / Recommended Usage:
# - 生产环境：使用 FASTME_CONFIG 指向配置文件，敏感信息用环境变量覆盖
#   Production: Use FASTME_CONFIG for config file, use env vars for sensitive info
# - 开发环境：直接修改 .env 文件快速切换配置
#   Development: Modify .env file for quick switching
# - Docker/CI: 使用环境变量注入覆盖配置文件
#   Docker/CI: Use environment variable injection to override config file

# =============================================================================
# 快速开始 / Quick Start
# =============================================================================
# 最简单的方式：使用配置文件 + 环境变量覆盖
# Simplest way: use config file + environment variable overrides
FASTME_CONFIG=./config/fastme_chroma.yaml

# =============================================================================
# LLM 配置 / LLM Configuration
# =============================================================================
# LLM API 地址 (兼容 OpenAI 格式)
# LLM API Endpoint (OpenAI-compatible format)
FASTME_LLM_BASE_URL=http://localhost:8000/v1

# LLM API Key (替换为你的实际密钥)
# LLM API Key (replace with your actual key)
FASTME_LLM_API_KEY=your-api-key-here

# LLM 模型名称
# LLM Model Name
FASTME_LLM_MODEL=qwen-plus

# =============================================================================
# Embedding 模型配置 / Embedding Model Configuration
# =============================================================================
# 方式 1: 使用本地已下载的模型（推荐，避免重复下载）
# Option 1: Use locally downloaded model (recommended, avoids re-downloading)
FASTME_EMBEDDING_MODEL=./models/bge-m3

# 方式 2: 使用 HuggingFace 模型名（首次使用会自动下载）
# Option 2: Use HuggingFace model name (will auto-download on first use)
# FASTME_EMBEDDING_MODEL=BAAI/bge-m3

# 模型缓存目录（当使用 HuggingFace 模型名时生效）
# Model cache directory (only used when FASTME_EMBEDDING_MODEL is a HuggingFace model name)
FASTME_MODEL_CACHE_DIR=./models

# =============================================================================
# 向量库配置 / Vector Store Configuration
# =============================================================================
# 向量库类型：chroma | faiss | milvus | qdrant | weaviate
# 切换向量库只需修改这一行即可
# Vector store type: change this line to switch vector store
FASTME_VECTOR_STORE_TYPE=chroma

# Chroma 配置（FASTME_VECTOR_STORE_TYPE=chroma 时生效）
# Chroma configuration (effective when FASTME_VECTOR_STORE_TYPE=chroma)
FASTME_CHROMA_PERSIST_DIR=./data/chroma
FASTME_CHROMA_COLLECTION=fastme_rag

# FAISS 配置（FASTME_VECTOR_STORE_TYPE=faiss 时生效）
# FAISS configuration (effective when FASTME_VECTOR_STORE_TYPE=faiss)
FASTME_FAISS_INDEX_PATH=./data/faiss_index

# =============================================================================
# 其他配置 / Other Configuration
# =============================================================================
# 界面语言：zh (中文) | en (English)
# UI Language
FASTME_LANGUAGE=zh

# 日志级别：DEBUG | INFO | WARNING | ERROR
# Log level
FASTME_LOG_LEVEL=INFO

# =============================================================================
# 别名兼容说明 / Backward Compatibility Notes
# =============================================================================
# 以下旧名称仍然支持，但建议使用上述统一命名：
# The following old names are still supported, but unified naming is recommended:
# - EMBEDDING_MODEL → FASTME_EMBEDDING_MODEL
# - MODEL_CACHE_DIR → FASTME_MODEL_CACHE_DIR
# - LLM_MODEL → FASTME_LLM_MODEL
# - LLM_BASE_URL → FASTME_LLM_BASE_URL
# - LLM_API_KEY → FASTME_LLM_API_KEY
# - CHROMA_DIR → FASTME_CHROMA_PERSIST_DIR
# - CHROMA_PERSIST_DIR → FASTME_CHROMA_PERSIST_DIR (同义)