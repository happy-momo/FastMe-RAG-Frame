# =====================================================================
# FastMe RAG Chatbot Demo — 环境变量模板
# 复制到仓库根目录的 .env 供 docker compose 读取：
#   cp backend/.env.example .env
# 或在 shell 中 export 后直接 uvicorn 运行。
#
# 唯一"必须"配置的是你的 LLM 端点（OpenAI 兼容 /v1）。
# =====================================================================

# ===== LLM（用户自带 OpenAI 兼容端点）=====
# 示例：远程服务 / 本机 Ollama / vLLM
# 注意：openai 客户端要求 api_key 非空。本地无鉴权服务填占位值即可（如 not-needed）
FASTME_LLM_BASE_URL=http://localhost:8000/v1
FASTME_LLM_API_KEY=not-needed
FASTME_LLM_MODEL=qwen-plus

# ===== Embedding（A2：有本地则用，无则自动下载）=====
# 方式1：使用 HuggingFace 模型名（首次启动自动下载到卷）
EMBEDDING_MODEL=BAAI/bge-m3
# 方式2：使用本地已下载模型（挂载卷内路径）
# EMBEDDING_MODEL=/app/models/bge-m3
MODEL_CACHE_DIR=/app/models
# 国内镜像（可选）
# HF_ENDPOINT=https://hf-mirror.com

# ===== 向量库 =====
FASTME_VECTOR_STORE_TYPE=chroma
FASTME_CHROMA_PERSIST_DIR=/app/data/chroma
FASTME_CHROMA_COLLECTION=fastme_rag

# ===== 其他 =====
FASTME_LANGUAGE=zh